<Window x:Class="KeepClip.UI.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:KeepClip.Localization"
        Title="KeepClip Player"
        Width="1120"
        Height="780"
        MinWidth="820"
        MinHeight="580"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        WindowStyle="None"
        KeyDown="Window_KeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Dark Titlebar -->
        <DockPanel Grid.Row="0" Background="{DynamicResource SidebarBgBrush}">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Content="—" Width="42" Height="34" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource BodyTextBrush}" Cursor="Hand" Click="Minimize_Click" />
                <Button Content="☐" Width="42" Height="34" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource BodyTextBrush}" Cursor="Hand" Click="Maximize_Click" />
                <Button Content="✕" Width="44" Height="34" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource BodyTextBrush}" Cursor="Hand" Click="Close_Click" />
            </StackPanel>
            <TextBlock Text="KeepClip Player" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"
                       VerticalAlignment="Center" Margin="14,0,0,0" />
        </DockPanel>

        <Grid Grid.Row="1" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="180" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="✕" Padding="12,6" Click="Close_Click" />
            <StackPanel>
                <TextBlock x:Name="GameText" FontSize="17" FontWeight="SemiBold" />
                <TextBlock x:Name="FileText" Style="{StaticResource SubtleText}" />
            </StackPanel>
        </DockPanel>

        <!-- Video + Side Actions -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#000000" CornerRadius="12" ClipToBounds="True">
                <Grid x:Name="VideoHost">
                    <MediaElement x:Name="VideoMedia" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform"
                                  MediaOpened="VideoMedia_MediaOpened" MediaEnded="VideoMedia_MediaEnded" />

                    <!-- Subtitle Overlay -->
                    <Border x:Name="SubtitleOverlay" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                            Margin="24,0,24,18" Background="#CC070A10" CornerRadius="8" Padding="12,6" Visibility="Collapsed">
                        <TextBlock x:Name="SubtitleText" Foreground="#FFFFFF" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" />
                    </Border>

                    <!-- Preparing Proxy Overlay -->
                    <Border x:Name="PreparingOverlay" Background="#E6070A10" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="320">
                            <TextBlock Text="{Binding [player.preparingPreview], Source={x:Static loc:Loc.Instance}}"
                                       FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <ProgressBar x:Name="PreparingBar" Height="6" Minimum="0" Maximum="1" Margin="0,12,0,6"
                                         Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource Card2Brush}" BorderThickness="0" />
                            <TextBlock x:Name="PreparingPct" Style="{StaticResource SubtleText}" HorizontalAlignment="Center" Text="0%" />
                            <TextBlock x:Name="PreparingDetail" Style="{StaticResource SubtleText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Button x:Name="FavBtn" Style="{StaticResource DarkButton}" Margin="0,0,0,8" Click="Fav_Click" />
                    <Button Style="{StaticResource PrimaryButton}" Margin="0,0,0,8"
                            Content="{Binding [playerActions.cut], Source={x:Static loc:Loc.Instance}}" Click="Cut_Click" />
                    <Button x:Name="CloudBtn" Style="{StaticResource DarkButton}" Margin="0,0,0,8"
                            Content="{Binding [playerActions.cloud], Source={x:Static loc:Loc.Instance}}" Click="Cloud_Click" Visibility="Collapsed" />
                    <Button x:Name="FoldersBtn" Style="{StaticResource DarkButton}" Margin="0,0,0,8"
                            Content="{Binding [playerActions.folders], Source={x:Static loc:Loc.Instance}}" Click="Folders_Click" />
                    <Button x:Name="RetranscribeBtn" Style="{StaticResource DarkButton}" Margin="0,0,0,8"
                            Content="{Binding [playerActions.retranscribe], Source={x:Static loc:Loc.Instance}}" Click="Retranscribe_Click" />
                    <Button x:Name="TranscriptTxtBtn" Style="{StaticResource DarkButton}" Margin="0,0,0,8"
                            Content="{Binding [playerActions.transcriptTxt], Source={x:Static loc:Loc.Instance}}" Click="TranscriptTxt_Click" />
                    <Button x:Name="FixBtn" Style="{StaticResource DarkButton}" Margin="0,0,0,8"
                            Content="{Binding [playerActions.fix], Source={x:Static loc:Loc.Instance}}" Click="Fix_Click" />
                    <Button Style="{StaticResource DangerButton}"
                            Content="{Binding [playerActions.delete], Source={x:Static loc:Loc.Instance}}" Click="Delete_Click" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Controls -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="14,10" Margin="0,10,0,8">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Button Style="{StaticResource DarkButton}" Content="📷" Padding="10,6" Margin="0,0,6,0" Click="Snap_Click"
                                ToolTip="{Binding [player.titlebar.snap], Source={x:Static loc:Loc.Instance}}" />
                        <Button x:Name="MuteBtn" Style="{StaticResource DarkButton}" Content="🔊" Padding="10,6" Margin="0,0,6,0" Click="Mute_Click" />
                        <Slider x:Name="VolumeSlider" Width="80" Minimum="0" Maximum="1" Value="1" VerticalAlignment="Center" Margin="0,0,10,0"
                                ValueChanged="VolumeSlider_ValueChanged" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <Button x:Name="SpeedBtn" Style="{StaticResource DarkButton}" Content="1×" Padding="10,6" Margin="0,0,6,0" Click="Speed_Click" />
                        <Button x:Name="CcBtn" Style="{StaticResource DarkButton}" Content="CC" Padding="10,6" Margin="0,0,6,0" Click="Cc_Click" />
                        <Button Style="{StaticResource DarkButton}" Content="⛶" Padding="10,6" Click="Fullscreen_Click" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource DarkButton}" Content="⏮" Padding="10,6" Margin="0,0,6,0" Click="Start_Click" />
                        <Button Style="{StaticResource DarkButton}" Content="-5s" Padding="10,6" Margin="0,0,6,0" Click="Rewind_Click" />
                        <Button x:Name="PlayPauseBtn" Style="{StaticResource PrimaryButton}" Content="▶" Padding="18,6" Margin="0,0,6,0" Click="PlayPause_Click" />
                        <Button Style="{StaticResource DarkButton}" Content="+5s" Padding="10,6" Margin="0,0,6,0" Click="Forward_Click" />
                        <Button Style="{StaticResource DarkButton}" Content="⏭" Padding="10,6" Click="End_Click" />
                    </StackPanel>
                </DockPanel>

                <DockPanel>
                    <TextBlock x:Name="CurrentTimeText" DockPanel.Dock="Left" Style="{StaticResource SubtleText}" VerticalAlignment="Center" Width="48" Text="0:00" />
                    <TextBlock x:Name="TotalTimeText" DockPanel.Dock="Right" Style="{StaticResource SubtleText}" VerticalAlignment="Center" Width="48" TextAlignment="Right" Text="0:00" />
                    <Slider x:Name="SeekSlider" Minimum="0" Maximum="1" VerticalAlignment="Center" Margin="10,0"
                            ValueChanged="SeekSlider_ValueChanged" />
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- CS2 Demo Panel -->
        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="14,10" Margin="0,0,0,8">
            <StackPanel>
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="{Binding [demo.title], Source={x:Static loc:Loc.Instance}}" FontWeight="SemiBold" />
                    <TextBlock x:Name="DemoStatusText" Style="{StaticResource SubtleText}" Margin="12,0,0,0" VerticalAlignment="Center" />
                </DockPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="DemoPathBox" Grid.Column="0" Style="{StaticResource DarkTextBox}"
                             Tag="{Binding [demo.placeholder], Source={x:Static loc:Loc.Instance}}"
                             Margin="0,0,8,0" />
                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="{Binding [demo.browse], Source={x:Static loc:Loc.Instance}}" Margin="0,0,6,0" Click="DemoBrowse_Click" />
                    <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="{Binding [demo.assign], Source={x:Static loc:Loc.Instance}}" Margin="0,0,6,0" Click="DemoAssign_Click" />
                    <Button x:Name="DemoShowBtn" Grid.Column="3" Style="{StaticResource GhostButton}" Content="{Binding [demo.show], Source={x:Static loc:Loc.Instance}}" Margin="0,0,6,0" Visibility="Collapsed" Click="DemoShow_Click" />
                    <Button x:Name="DemoRemoveBtn" Grid.Column="4" Style="{StaticResource DangerButton}" Content="{Binding [demo.detach], Source={x:Static loc:Loc.Instance}}" Visibility="Collapsed" Click="DemoRemove_Click" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Segments -->
        <Border Grid.Row="4" Style="{StaticResource CardBorder}" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="SegmentsPanel" />
            </ScrollViewer>
        </Border>
    </Grid>
    </Grid>
</Window>

