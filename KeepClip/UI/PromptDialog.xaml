<Window x:Class="KeepClip.UI.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        Width="440"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Border Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="22">
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="BodyText" Style="{StaticResource SubtleText}" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="13" />
            <TextBox x:Name="InputBox" Style="{StaticResource DarkTextBox}" Margin="0,14,0,0" Visibility="Collapsed" />
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="0,6,0,0" Visibility="Collapsed" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="CancelBtn" Style="{StaticResource GhostButton}" Margin="0,0,10,0" Click="Cancel_Click" />
                <Button x:Name="OkBtn" Style="{StaticResource PrimaryButton}" Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

