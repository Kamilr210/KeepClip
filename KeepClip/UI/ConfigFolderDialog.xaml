<Window x:Class="KeepClip.UI.ConfigFolderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        Width="548"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Margin="14"
            Background="{DynamicResource CardBrush}"
            BorderBrush="#2D3344"
            BorderThickness="1"
            CornerRadius="16"
            Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.6" Color="#000000" />
        </Border.Effect>
        <StackPanel>
            <DockPanel Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Button x:Name="CloseXBtn" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="✕" Padding="9,3" Margin="10,0,0,0" Click="Cancel_Click" />
                <TextBlock x:Name="TitleText" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock x:Name="IntroText" Style="{StaticResource SubtleText}" Margin="0,8,0,16" TextWrapping="Wrap" FontSize="13" LineHeight="19" />
            <TextBlock x:Name="PathLabel" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="BrowseBtn" Grid.Column="0" Style="{StaticResource DarkButton}" Content="📁" Padding="12,8" Margin="0,0,8,0" Click="Browse_Click" />
                <TextBox x:Name="PathBox" Grid.Column="1" Style="{StaticResource DarkTextBox}" />
            </Grid>
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="CancelBtn" Style="{StaticResource GhostButton}" Margin="0,0,10,0" Click="Cancel_Click" />
                <Button x:Name="SaveBtn" Style="{StaticResource PrimaryButton}" Padding="16,8" Click="Save_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
