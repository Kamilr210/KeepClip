<Window x:Class="KeepClip.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:KeepClip.Localization"
        Title="KeepClip"
        Width="1280"
        Height="800"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        WindowStyle="None"
        AllowsTransparency="False">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <DataTemplate x:Key="ClipCardTemplate">
            <Border Width="290" Margin="0,0,14,14" Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12"
                    Cursor="Hand" MouseLeftButtonUp="ClipCard_Click">
                <StackPanel>
                    <!-- Thumbnail -->
                    <Grid Height="162" ClipToBounds="True">
                        <Border Background="#0B0E16" CornerRadius="11,11,0,0">
                            <Grid>
                                <TextBlock Text="🎬" FontSize="28" Opacity="0.22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                            </Grid>
                        </Border>
                        <!-- Cloud / Duration / Fav overlays -->
                        <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="8"
                                Background="#B3070A10" CornerRadius="6" Padding="6,2"
                                Visibility="{Binding IsCloud, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="☁" FontSize="11" Foreground="#8AB8FF" />
                        </Border>
                        <Button VerticalAlignment="Top" HorizontalAlignment="Right" Margin="8"
                                Content="{Binding FavStar}" FontSize="15" Padding="6,2"
                                Background="#B3070A10" Foreground="#ECEC00" BorderThickness="0"
                                Cursor="Hand" Click="CardFav_Click" Tag="{Binding}" />
                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="8"
                                Background="#CC070A10" CornerRadius="6" Padding="6,2">
                            <TextBlock Text="{Binding DurationText}" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                        <!-- Selection Check -->
                        <CheckBox VerticalAlignment="Top" HorizontalAlignment="Left" Margin="8"
                                  IsChecked="{Binding Selected}"
                                  Visibility="{Binding DataContext.IsSelectionMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                                  Click="CardSelect_Click" />
                    </Grid>

                    <!-- Info -->
                    <StackPanel Margin="12,10,12,12">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="⋯" Background="Transparent" BorderThickness="0"
                                    Foreground="{DynamicResource MutedBrush}" FontSize="16" Padding="6,0"
                                    Cursor="Hand" Click="CardMenu_Click" Tag="{Binding}" />
                            <TextBlock Text="{Binding Filename}" FontWeight="SemiBold" FontSize="13"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="{Binding DisplayGame}" Foreground="{DynamicResource AccentPaleBrush}" FontSize="11.5" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding MetaText}" Style="{StaticResource SubtleText}" FontSize="11.5" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding TranscribedBadge}" Style="{StaticResource SubtleText}" FontSize="11" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding Snippet}" Foreground="#FFD86B" FontSize="11.5" Margin="0,4,0,0"
                                   TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasSnippet, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- Animated Background Orbs -->
        <Canvas x:Name="OrbsCanvas" IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse x:Name="Orb1" Width="620" Height="620" Canvas.Left="-140" Canvas.Top="-180" Opacity="0.35">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="{DynamicResource AccentOrbColor}" Offset="0" />
                        <GradientStop Color="{DynamicResource AccentOrbDeepColor}" Offset="0.45" />
                        <GradientStop Color="Transparent" Offset="0.85" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <BlurEffect Radius="85" />
                </Ellipse.Effect>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="Orb1Transform" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="Orb2" Width="540" Height="540" Canvas.Right="-60" Canvas.Bottom="-140" Opacity="0.30">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#1A72D4" Offset="0" />
                        <GradientStop Color="#0A3A7A" Offset="0.45" />
                        <GradientStop Color="Transparent" Offset="0.85" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <BlurEffect Radius="85" />
                </Ellipse.Effect>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="Orb2Transform" />
                </Ellipse.RenderTransform>
            </Ellipse>
        </Canvas>

        <!-- Main Layout -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Custom Titlebar -->
            <DockPanel Grid.Row="0" Background="Transparent">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="—" Width="44" Height="34" Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource BodyTextBrush}" Cursor="Hand" Click="Minimize_Click" />
                    <Button Content="☐" Width="44" Height="34" Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource BodyTextBrush}" Cursor="Hand" Click="Maximize_Click" />
                    <Button Content="✕" Width="46" Height="34" Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource BodyTextBrush}" Cursor="Hand" Click="Close_Click" />
                </StackPanel>
                <TextBlock Text="KEEPCLIP" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}"
                           VerticalAlignment="Center" Margin="16,0,0,0" />
            </DockPanel>

            <!-- App Shell -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarCol" Width="260" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0" Background="{DynamicResource SidebarBgBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,1,0" Padding="14,16">
                    <DockPanel>
                        <!-- Brand -->
                        <DockPanel DockPanel.Dock="Top" Margin="4,0,4,18">
                            <Button x:Name="SidebarToggleBtn" DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                                    Content="◀" Padding="8,4" FontSize="11" Click="SidebarToggle_Click" />
                            <StackPanel x:Name="BrandPanel" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="24" Height="24" CornerRadius="6" Background="{DynamicResource AccentBrush}" Margin="0,0,10,0">
                                    <TextBlock Text="▶" Foreground="#FFFFFF" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="KEEP" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Text="CLIP" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource AccentPaleBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>

                        <!-- Bottom Cloud Card -->
                        <Border DockPanel.Dock="Bottom" Style="{StaticResource CardBorder}" Padding="12" Margin="0,12,0,0"
                                Cursor="Hand" MouseLeftButtonUp="CloudCard_Click">
                            <StackPanel>
                                <DockPanel>
                                    <Ellipse x:Name="SidebarCloudDot" Width="8" Height="8" DockPanel.Dock="Right" Fill="#8F8F8F" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding [nav.cloud], Source={x:Static loc:Loc.Instance}}" FontWeight="SemiBold" FontSize="13" />
                                </DockPanel>
                                <TextBlock x:Name="SidebarCloudStatus" Style="{StaticResource SubtleText}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <!-- Navigation -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="{Binding [nav.sectionMain], Source={x:Static loc:Loc.Instance}}"
                                           Style="{StaticResource SubtleText}" FontSize="11" FontWeight="SemiBold" Margin="10,0,0,6" />
                                <Button x:Name="NavClips" Style="{StaticResource NavButton}" Tag="active" Click="NavView_Click" CommandParameter="clips">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🎬" Margin="0,0,10,0" />
                                        <TextBlock x:Name="LblNavClips" Text="{Binding [nav.clips], Source={x:Static loc:Loc.Instance}}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NavFolders" Style="{StaticResource NavButton}" Click="NavView_Click" CommandParameter="folders">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📁" Margin="0,0,10,0" />
                                        <TextBlock x:Name="LblNavFolders" Text="{Binding [nav.folders], Source={x:Static loc:Loc.Instance}}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NavFavorites" Style="{StaticResource NavButton}" Click="NavView_Click" CommandParameter="favorites">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⭐" Margin="0,0,10,0" />
                                        <TextBlock x:Name="LblNavFavorites" Text="{Binding [nav.favorites], Source={x:Static loc:Loc.Instance}}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NavCloud" Style="{StaticResource NavButton}" Click="NavView_Click" CommandParameter="cloud">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="☁" Margin="0,0,10,0" />
                                        <TextBlock x:Name="LblNavCloud" Text="{Binding [nav.cloud], Source={x:Static loc:Loc.Instance}}" />
                                    </StackPanel>
                                </Button>

                                <TextBlock Text="{Binding [nav.sectionTools], Source={x:Static loc:Loc.Instance}}"
                                           Style="{StaticResource SubtleText}" FontSize="11" FontWeight="SemiBold" Margin="10,16,0,6" />
                                <Button x:Name="BtnScan" Style="{StaticResource NavButton}" Click="Scan_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔍" Margin="0,0,10,0" />
                                        <TextBlock x:Name="LblScan" Text="{Binding [nav.scanFolder], Source={x:Static loc:Loc.Instance}}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnReplay" Style="{StaticResource NavButton}" Click="Replay_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⏺" Margin="0,0,10,0" />
                                        <TextBlock x:Name="LblReplay" Text="{Binding [nav.replay], Source={x:Static loc:Loc.Instance}}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnTranscribe" Style="{StaticResource NavButton}" Click="TranscribeNew_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✨" Margin="0,0,10,0" />
                                        <TextBlock x:Name="LblTranscribe" Text="{Binding [nav.transcribeNew], Source={x:Static loc:Loc.Instance}}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnCancelTranscribe" Style="{StaticResource NavButton}" Visibility="Collapsed" Click="CancelTranscribe_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✕" Margin="0,0,10,0" Foreground="{DynamicResource DangerBrush}" />
                                        <TextBlock Text="{Binding [nav.cancel], Source={x:Static loc:Loc.Instance}}" Foreground="{DynamicResource DangerBrush}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnRetranscribeAll" Style="{StaticResource NavButton}" Click="RetranscribeAll_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="↻" Margin="0,0,10,0" />
                                        <TextBlock x:Name="LblRetranscribe" Text="{Binding [nav.retranscribeAll], Source={x:Static loc:Loc.Instance}}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NavSettings" Style="{StaticResource NavButton}" Click="NavView_Click" CommandParameter="settings">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚙" Margin="0,0,10,0" />
                                        <TextBlock x:Name="LblSettings" Text="{Binding [nav.settings], Source={x:Static loc:Loc.Instance}}" />
                                    </StackPanel>
                                </Button>

                                <!-- DEV Tools -->
                                <Button x:Name="BtnDevLogs" Style="{StaticResource NavButton}" Visibility="Collapsed" Click="DevLogs_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📄" Margin="0,0,10,0" />
                                        <TextBlock Text="Logi aplikacji" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnDevResources" Style="{StaticResource NavButton}" Visibility="Collapsed" Click="DevResources_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📊" Margin="0,0,10,0" />
                                        <TextBlock Text="Zużycie zasobów" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Main Content -->
                <Grid Grid.Column="1" Margin="22,10,22,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Update Banner -->
                    <Border x:Name="UpdateBanner" Grid.Row="0" Style="{StaticResource CardBorder}" Padding="14,10" Margin="0,0,0,12" Visibility="Collapsed">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Button Style="{StaticResource GhostButton}" Content="{Binding [update.later], Source={x:Static loc:Loc.Instance}}" Margin="0,0,8,0" Click="UpdateLater_Click" />
                                <Button Style="{StaticResource PrimaryButton}" Content="{Binding [update.installBtn], Source={x:Static loc:Loc.Instance}}" Click="UpdateInstall_Click" />
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding [update.title], Source={x:Static loc:Loc.Instance}}" FontWeight="SemiBold" />
                                <TextBlock x:Name="UpdateVersionText" Style="{StaticResource SubtleText}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Transcribe Progress -->
                    <Border x:Name="ProgressBanner" Grid.Row="1" Style="{StaticResource CardBorder}" Padding="14,10" Margin="0,0,0,12" Visibility="Collapsed">
                        <StackPanel>
                            <DockPanel>
                                <Button x:Name="ProgressCloseBtn" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="✕" Padding="8,2" Visibility="Collapsed" Click="ProgressClose_Click" />
                                <TextBlock x:Name="ProgressText" DockPanel.Dock="Right" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <ProgressBar x:Name="ProgressBar" Height="8" Minimum="0" Maximum="1" VerticalAlignment="Center" Margin="0,0,12,0"
                                             Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource Card2Brush}" BorderThickness="0" />
                            </DockPanel>
                            <TextBlock x:Name="ProgressCurrentText" Style="{StaticResource SubtleText}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Selection Bar -->
                    <Border x:Name="SelectionBar" Grid.Row="2" Style="{StaticResource CardBorder}" Padding="14,10" Margin="0,0,0,12" Visibility="Collapsed">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Button Style="{StaticResource GhostButton}" Content="{Binding [selection.cancel], Source={x:Static loc:Loc.Instance}}" Margin="0,0,8,0" Click="SelectionCancel_Click" />
                                <Button x:Name="SelectionAddBtn" Style="{StaticResource PrimaryButton}" Content="{Binding [selection.addSelected], Source={x:Static loc:Loc.Instance}}" IsEnabled="False" Click="SelectionAdd_Click" />
                            </StackPanel>
                            <TextBlock x:Name="SelectionInfoText" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </DockPanel>
                    </Border>

                    <!-- Views -->
                    <Grid Grid.Row="3">
                        <!-- VIEW 1: CLIPS -->
                        <ScrollViewer x:Name="ViewClips" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Search & Filters -->
                                <Border Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="150" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="SearchBox" Grid.Column="0" Style="{StaticResource DarkTextBox}"
                                                 Tag="{Binding [search.placeholder], Source={x:Static loc:Loc.Instance}}"
                                                 TextChanged="SearchBox_TextChanged" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0">
                                            <Button x:Name="LayoutGridBtn" Style="{StaticResource PrimaryButton}" Content="⊞" Padding="10,6" Margin="0,0,4,0" Click="LayoutGrid_Click" />
                                            <Button x:Name="LayoutMosaicBtn" Style="{StaticResource DarkButton}" Content="⊟" Padding="10,6" Click="LayoutMosaic_Click" />
                                        </StackPanel>
                                        <ComboBox x:Name="GameFilterCombo" Grid.Column="2" Style="{StaticResource DarkComboBox}" Margin="0,0,10,0"
                                                  SelectionChanged="Filter_Changed" />
                                        <ComboBox x:Name="SortCombo" Grid.Column="3" Style="{StaticResource DarkComboBox}"
                                                  SelectionChanged="Filter_Changed" />
                                    </Grid>
                                </Border>

                                <!-- Stats Cards -->
                                <UniformGrid Columns="3" Margin="0,0,0,14">
                                    <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,10,0">
                                        <StackPanel>
                                            <TextBlock x:Name="StatClipsText" Text="0" FontSize="24" FontWeight="Bold" />
                                            <TextBlock Text="{Binding [stat.allClips], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SubtleText}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardBorder}" Padding="16" Margin="5,0">
                                        <StackPanel>
                                            <TextBlock x:Name="StatTransText" Text="0" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource GoodBrush}" />
                                            <TextBlock Text="{Binding [stat.transcribed], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SubtleText}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardBorder}" Padding="16" Margin="10,0,0,0">
                                        <StackPanel>
                                            <TextBlock x:Name="StatFavText" Text="0" FontSize="24" FontWeight="Bold" Foreground="#ECEC00" />
                                            <TextBlock Text="{Binding [stat.favorites], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SubtleText}" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!-- Storage Cards -->
                                <UniformGrid Columns="2" Margin="0,0,0,16">
                                    <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,8,0">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBlock x:Name="LocalFreeText" DockPanel.Dock="Right" Style="{StaticResource SubtleText}" />
                                                <TextBlock Text="{Binding [storageTitle.localDisk], Source={x:Static loc:Loc.Instance}}" FontWeight="SemiBold" />
                                            </DockPanel>
                                            <ProgressBar x:Name="LocalDiskBar" Height="6" Minimum="0" Maximum="1" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource Card2Brush}" BorderThickness="0" />
                                            <TextBlock x:Name="LocalLegendText" Style="{StaticResource SubtleText}" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardBorder}" Padding="14" Margin="8,0,0,0">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBlock x:Name="CloudFreeText" DockPanel.Dock="Right" Style="{StaticResource SubtleText}" />
                                                <TextBlock Text="{Binding [storageTitle.cloudDrive], Source={x:Static loc:Loc.Instance}}" FontWeight="SemiBold" />
                                            </DockPanel>
                                            <ProgressBar x:Name="CloudDiskBar" Height="6" Minimum="0" Maximum="1" Foreground="#4285F4" Background="{DynamicResource Card2Brush}" BorderThickness="0" />
                                            <TextBlock x:Name="CloudLegendText" Style="{StaticResource SubtleText}" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!-- Clips Grid -->
                                <TextBlock x:Name="ClipsEmptyText" Style="{StaticResource SubtleText}" FontSize="14" HorizontalAlignment="Center" Margin="0,30" Visibility="Collapsed" />
                                <ItemsControl x:Name="ClipsItems" ItemTemplate="{StaticResource ClipCardTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- VIEW 2: FOLDERS -->
                        <ScrollViewer x:Name="ViewFolders" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel>
                                <StackPanel x:Name="FoldersIndexPanel">
                                    <DockPanel Margin="0,0,0,16">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                                                Content="{Binding [folders.newFolderBtn], Source={x:Static loc:Loc.Instance}}" Click="NewFolder_Click" />
                                        <TextBlock Text="{Binding [folders.yourFolders], Source={x:Static loc:Loc.Instance}}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <WrapPanel x:Name="FoldersGridPanel" />
                                </StackPanel>

                                <StackPanel x:Name="FolderDetailPanel" Visibility="Collapsed">
                                    <DockPanel Margin="0,0,0,14">
                                        <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}"
                                                Content="{Binding [folderDetail.back], Source={x:Static loc:Loc.Instance}}" Margin="0,0,12,0" Click="BackFolders_Click" />
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                            <Button Style="{StaticResource PrimaryButton}" Content="{Binding [folderDetail.selectClips], Source={x:Static loc:Loc.Instance}}" Margin="0,0,8,0" Click="SelectClipsForFolder_Click" />
                                            <Button x:Name="UploadFolderBtn" Style="{StaticResource DarkButton}" Content="{Binding [folderDetail.uploadCloudBtn], Source={x:Static loc:Loc.Instance}}" Margin="0,0,8,0" Visibility="Collapsed" Click="UploadFolder_Click" />
                                            <Button Style="{StaticResource GhostButton}" Content="✎" Margin="0,0,8,0" Click="RenameFolder_Click" />
                                            <Button Style="{StaticResource DangerButton}" Content="🗑" Click="DeleteFolder_Click" />
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="FolderDetailName" FontSize="20" FontWeight="Bold" />
                                            <TextBlock x:Name="FolderDetailCount" Style="{StaticResource SubtleText}" />
                                        </StackPanel>
                                    </DockPanel>

                                    <Border Style="{StaticResource CardBorder}" Padding="14,10" Margin="0,0,0,14">
                                        <DockPanel>
                                            <CheckBox x:Name="FolderHideHomeBox" DockPanel.Dock="Right" Style="{StaticResource SwitchCheckBox}"
                                                      VerticalAlignment="Center" Click="FolderHideHome_Click" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding [folderDetail.hideFromHome], Source={x:Static loc:Loc.Instance}}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding [folderDetail.homeVisibilityHint], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SubtleText}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>

                                    <ItemsControl x:Name="FolderClipsItems" ItemTemplate="{StaticResource ClipCardTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- VIEW 3: FAVORITES -->
                        <ScrollViewer x:Name="ViewFavorites" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,16">
                                    <TextBlock x:Name="FavCountText" DockPanel.Dock="Right" Style="{StaticResource SubtleText}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding [nav.favorites], Source={x:Static loc:Loc.Instance}}" FontSize="22" FontWeight="Bold" />
                                </DockPanel>
                                <TextBlock x:Name="FavEmptyText" Text="{Binding [search.noFavorites], Source={x:Static loc:Loc.Instance}}"
                                           Style="{StaticResource SubtleText}" FontSize="14" HorizontalAlignment="Center" Margin="0,30" Visibility="Collapsed" />
                                <ItemsControl x:Name="FavClipsItems" ItemTemplate="{StaticResource ClipCardTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- VIEW 4: CLOUD -->
                        <ScrollViewer x:Name="ViewCloud" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel MaxWidth="740" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding [nav.cloud], Source={x:Static loc:Loc.Instance}}" FontSize="22" FontWeight="Bold" />
                                <TextBlock Text="{Binding [cloud.subtitle], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SubtleText}" Margin="0,4,0,18" />

                                <Border x:Name="CloudSetupPanel" Style="{StaticResource CardBorder}" Padding="22" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="{Binding [cloudPanel.setupTitle], Source={x:Static loc:Loc.Instance}}" FontSize="17" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding [cloudPanel.setupBody], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,8,0,12" />
                                        <TextBlock x:Name="CloudDataPathText" Style="{StaticResource SubtleText}" Margin="0,0,0,14" />
                                        <Button Style="{StaticResource PrimaryButton}" Content="{Binding [cloudPanel.recheckBtn], Source={x:Static loc:Loc.Instance}}" HorizontalAlignment="Left" Click="CloudRecheck_Click" />
                                    </StackPanel>
                                </Border>

                                <Border x:Name="CloudConnectPanel" Style="{StaticResource CardBorder}" Padding="24" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="{Binding [cloudx.heroTitle], Source={x:Static loc:Loc.Instance}}" FontSize="19" FontWeight="Bold" />
                                        <TextBlock Text="{Binding [cloudx.heroBody], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,8,0,16" />
                                        <Button x:Name="CloudConnectBtn" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                                                Content="{Binding [cloudPanel.connectBtn], Source={x:Static loc:Loc.Instance}}" Click="CloudConnect_Click" />
                                        <TextBlock Text="{Binding [cloudx.footer], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SubtleText}" Margin="0,12,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border x:Name="CloudAccountPanel" Style="{StaticResource CardBorder}" Padding="22" Visibility="Collapsed">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,14">
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                <Button Style="{StaticResource DarkButton}" Content="↻ Sync" Margin="0,0,8,0" Click="CloudSync_Click" />
                                                <Button Style="{StaticResource GhostButton}" Content="{Binding [cloudPanel.disconnectBtn], Source={x:Static loc:Loc.Instance}}" Click="CloudDisconnect_Click" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock x:Name="CloudAccName" FontSize="16" FontWeight="SemiBold" />
                                                <TextBlock x:Name="CloudAccEmail" Style="{StaticResource SubtleText}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <ProgressBar x:Name="CloudQuotaBar" Height="8" Minimum="0" Maximum="1" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource Card2Brush}" BorderThickness="0" />
                                        <TextBlock x:Name="CloudQuotaText" Style="{StaticResource SubtleText}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- VIEW 5: SETTINGS -->
                        <ScrollViewer x:Name="ViewSettings" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                                <DockPanel Margin="0,0,0,18">
                                    <TextBox x:Name="SettingsSearchBox" DockPanel.Dock="Right" Width="240" Style="{StaticResource DarkTextBox}"
                                             Tag="{Binding [settings.searchPlaceholder], Source={x:Static loc:Loc.Instance}}"
                                             TextChanged="SettingsSearch_TextChanged" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding [settings.title], Source={x:Static loc:Loc.Instance}}" FontSize="22" FontWeight="Bold" />
                                        <TextBlock Text="{Binding [settings.subtitle], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SubtleText}" />
                                    </StackPanel>
                                </DockPanel>

                                <!-- Appearance -->
                                <Border x:Name="SetGroupAppearance" Style="{StaticResource CardBorder}" Padding="18" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="{Binding [settings.appearanceTitle], Source={x:Static loc:Loc.Instance}}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                                        <DockPanel Margin="0,0,0,14">
                                            <ComboBox x:Name="ThemeCombo" DockPanel.Dock="Right" Width="200" Style="{StaticResource DarkComboBox}" SelectionChanged="ThemeCombo_Changed" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding [settings.themeLabel], Source={x:Static loc:Loc.Instance}}" FontWeight="Medium" />
                                                <TextBlock Text="{Binding [settings.themeSub], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SubtleText}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <DockPanel>
                                            <CheckBox x:Name="OrbToggleBox" DockPanel.Dock="Right" Style="{StaticResource SwitchCheckBox}" IsChecked="True" Click="OrbToggle_Click" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding [orb.label], Source={x:Static loc:Loc.Instance}}" FontWeight="Medium" />
                                                <TextBlock Text="{Binding [orb.sublabel], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SubtleText}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Language -->
                                <Border x:Name="SetGroupLanguage" Style="{StaticResource CardBorder}" Padding="18" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="{Binding [settings.languageTitle], Source={x:Static loc:Loc.Instance}}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                                        <DockPanel>
                                            <ComboBox x:Name="LangCombo" DockPanel.Dock="Right" Width="200" Style="{StaticResource DarkComboBox}" SelectionChanged="LangCombo_Changed" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding [ui.language], Source={x:Static loc:Loc.Instance}}" FontWeight="Medium" />
                                                <TextBlock Text="{Binding [settings.langSub], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SubtleText}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Clips -->
                                <Border x:Name="SetGroupClips" Style="{StaticResource CardBorder}" Padding="18" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="{Binding [settings.clipsTitle], Source={x:Static loc:Loc.Instance}}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                                        <DockPanel Margin="0,0,0,14">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource DarkButton}" Content="{Binding [settings.changeFolderBtn], Source={x:Static loc:Loc.Instance}}" Click="ChangeFolder_Click" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding [settings.folderLabel], Source={x:Static loc:Loc.Instance}}" FontWeight="Medium" />
                                                <TextBlock x:Name="SettingsFolderPath" Style="{StaticResource SubtleText}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <DockPanel Margin="0,0,0,14">
                                            <CheckBox x:Name="HideFolderClipsBox" DockPanel.Dock="Right" Style="{StaticResource SwitchCheckBox}" Click="HideFolderClips_Click" />
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="{Binding [settings.hideFolderClipsLabel], Source={x:Static loc:Loc.Instance}}" FontWeight="Medium" />
                                                <TextBlock Text="{Binding [settings.hideFolderClipsSub], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SubtleText}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DockPanel>
                                        <DockPanel>
                                            <CheckBox x:Name="FavoritesAfterRecentBox" DockPanel.Dock="Right" Style="{StaticResource SwitchCheckBox}" Click="FavoritesAfterRecent_Click" />
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="{Binding [settings.favoritesAfterRecentLabel], Source={x:Static loc:Loc.Instance}}" FontWeight="Medium" />
                                                <TextBlock Text="{Binding [settings.favoritesAfterRecentSub], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SubtleText}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Help & Discord -->
                                <Border x:Name="SetGroupHelp" Style="{StaticResource CardBorder}" Padding="18" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="{Binding [settings.helpTitle], Source={x:Static loc:Loc.Instance}}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                                        <DockPanel Margin="0,0,0,14">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource DarkButton}" Content="{Binding [onboarding.settingsBtn], Source={x:Static loc:Loc.Instance}}" Click="RunOnboarding_Click" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding [onboarding.settingsTitle], Source={x:Static loc:Loc.Instance}}" FontWeight="Medium" />
                                                <TextBlock Text="{Binding [onboarding.settingsSub], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SubtleText}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource DarkButton}" Content="{Binding [settings.supportButton], Source={x:Static loc:Loc.Instance}}" Click="OpenDiscord_Click" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding [settings.supportTitle], Source={x:Static loc:Loc.Instance}}" FontWeight="Medium" />
                                                <TextBlock Text="{Binding [settings.supportSub], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SubtleText}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock x:Name="VersionText" Style="{StaticResource SubtleText}" Margin="4,4,0,20" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>

