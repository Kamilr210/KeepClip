<Window x:Class="KeepClip.UI.ReplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:KeepClip.Localization"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        Width="560"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Border Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="24">
        <StackPanel>
            <TextBlock Text="{Binding [replay.title], Source={x:Static loc:Loc.Instance}}" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="{Binding [replay.intro], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SubtleText}" Margin="0,6,0,14" TextWrapping="Wrap" FontSize="12.5" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#8F8F8F" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock x:Name="StatusText" Style="{StaticResource SubtleText}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="HotkeyWarnText" Foreground="{DynamicResource WarnBrush}" FontSize="12" Margin="0,0,0,8" Visibility="Collapsed" TextWrapping="Wrap" />
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="0,0,0,8" Visibility="Collapsed" TextWrapping="Wrap" />

            <Border Background="{DynamicResource Card2Brush}" CornerRadius="10" Padding="14,10" Margin="0,4,0,12">
                <DockPanel>
                    <CheckBox x:Name="EnabledBox" DockPanel.Dock="Right" Style="{StaticResource SwitchCheckBox}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding [replay.enabled], Source={x:Static loc:Loc.Instance}}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <CheckBox x:Name="BackgroundBox" Margin="0,4" Foreground="{DynamicResource TextBrush}">
                <StackPanel>
                    <TextBlock Text="{Binding [replay.background], Source={x:Static loc:Loc.Instance}}" />
                    <TextBlock Text="{Binding [replay.backgroundHint], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SubtleText}" TextWrapping="Wrap" />
                </StackPanel>
            </CheckBox>
            <CheckBox x:Name="MicBox" Margin="0,8,0,14" Foreground="{DynamicResource TextBrush}"
                      Content="{Binding [replay.mic], Source={x:Static loc:Loc.Instance}}" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="{Binding [replay.duration], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SubtleText}" Margin="0,0,0,4" />
                    <ComboBox x:Name="DurationCombo" Style="{StaticResource DarkComboBox}" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Text="{Binding [replay.fps], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SubtleText}" Margin="0,0,0,4" />
                    <ComboBox x:Name="FpsCombo" Style="{StaticResource DarkComboBox}" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="0">
                    <TextBlock Text="{Binding [replay.quality], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SubtleText}" Margin="0,0,0,4" />
                    <ComboBox x:Name="QualityCombo" Style="{StaticResource DarkComboBox}" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2">
                    <TextBlock Text="{Binding [replay.hotkey], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SubtleText}" Margin="0,0,0,4" />
                    <TextBox x:Name="HotkeyBox" Style="{StaticResource DarkTextBox}" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{Binding [replay.audioSection], Source={x:Static loc:Loc.Instance}}" FontWeight="SemiBold" Margin="0,16,0,8" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding [replay.audioOutput], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SubtleText}" Margin="0,0,0,4" />
                    <ComboBox x:Name="AudioOutputCombo" Style="{StaticResource DarkComboBox}" DisplayMemberPath="Name" SelectedValuePath="Id" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{Binding [replay.audioInput], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SubtleText}" Margin="0,0,0,4" />
                    <ComboBox x:Name="AudioInputCombo" Style="{StaticResource DarkComboBox}" DisplayMemberPath="Name" SelectedValuePath="Id" />
                </StackPanel>
            </Grid>

            <DockPanel Margin="0,20,0,0">
                <Button x:Name="SaveNowBtn" DockPanel.Dock="Left" Style="{StaticResource GhostButton}"
                        Content="{Binding [replay.saveNow], Source={x:Static loc:Loc.Instance}}" Click="SaveNow_Click" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource GhostButton}" Content="{Binding [replay.close], Source={x:Static loc:Loc.Instance}}" Margin="0,0,10,0" Click="Close_Click" />
                    <Button x:Name="ApplyBtn" Style="{StaticResource PrimaryButton}" Content="{Binding [replay.apply], Source={x:Static loc:Loc.Instance}}" Click="Apply_Click" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>

