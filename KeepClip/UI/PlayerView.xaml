<UserControl x:Class="KeepClip.UI.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:KeepClip.Localization">
    <Border x:Name="RootBorder" Background="{DynamicResource BgBrush}" Padding="22,12,22,16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="HeaderRow" Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition x:Name="BelowRow" Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Header (hidden in Fullscreen; right margin leaves room for window controls) -->
            <DockPanel x:Name="TopHeaderBar" Grid.Row="0" Margin="0,0,145,10">
                <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Padding="11,6" Margin="0,0,14,0" Click="Close_Click" ToolTip="Esc">
                    <Path Data="M 10,2 L 3,8 L 10,14 M 3,8 L 15,8"
                          Stroke="{DynamicResource TextBrush}" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="16" Height="16" Stretch="Uniform" />
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource AccentPanelBrush}" CornerRadius="6" Padding="8,2" Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock x:Name="GameText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentPaleBrush}" />
                        </Border>
                        <TextBlock x:Name="FileText" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <!-- YouTube-Style Video Player Surface -->
            <Border x:Name="VideoHostBorder" Grid.Row="1" Background="#000000" CornerRadius="12" ClipToBounds="True"
                    MouseMove="VideoHost_MouseMove" MouseLeave="VideoHost_MouseLeave">
                <Grid x:Name="VideoGrid" Background="Transparent">
                    <MediaElement x:Name="VideoMedia" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform"
                                  MediaOpened="VideoMedia_MediaOpened" MediaEnded="VideoMedia_MediaEnded"
                                  MouseLeftButtonDown="VideoSurface_MouseLeftButtonDown" />

                    <!-- Clickable Transparent Hit Layer (catches clicks even on black letterbox bars) -->
                    <Border Background="Transparent" MouseLeftButtonDown="VideoSurface_MouseLeftButtonDown" Panel.ZIndex="1" />

                    <!-- Fullscreen Top Gradient Header Overlay -->
                    <Border x:Name="FullscreenTopOverlay" VerticalAlignment="Top" Padding="20,16,20,28"
                            Visibility="Collapsed" Opacity="0" Panel.ZIndex="4" IsHitTestVisible="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#CC05070C" Offset="0" />
                                <GradientStop Color="#0005070C" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <DockPanel>
                            <Button DockPanel.Dock="Left" Style="{StaticResource PlayerIconButton}" Margin="0,0,12,0" Click="ExitFullscreen_Click"
                                    ToolTip="{Binding [player.exitFullscreen], Source={x:Static loc:Loc.Instance}}">
                                <Path Data="M 10,2 L 3,8 L 10,14 M 3,8 L 15,8"
                                      Stroke="#FFFFFF" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="16" Height="16" Stretch="Uniform" />
                            </Button>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="FsFileText" Foreground="#FFFFFF" FontSize="15.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="FsGameText" Foreground="#B8C0D4" FontSize="12" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Center Transient Feedback Badge (YouTube-style Play/Pause/Seek indicator) -->
                    <Border x:Name="CenterFeedback" Width="68" Height="68" CornerRadius="34"
                            Background="#AA070A10" BorderBrush="#26FFFFFF" BorderThickness="1"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsHitTestVisible="False" Opacity="0" Panel.ZIndex="3">
                        <TextBlock x:Name="CenterFeedbackText" Foreground="#FFFFFF" FontSize="22" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- Subtitles Overlay -->
                    <Border x:Name="SubtitleOverlay" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                            Margin="28,0,28,84" Background="#CC070A10" CornerRadius="8" Padding="14,7"
                            Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="3">
                        <TextBlock x:Name="SubtitleText" Foreground="#FFFFFF" FontSize="15.5" FontWeight="SemiBold"
                                   TextWrapping="Wrap" TextAlignment="Center" />
                    </Border>

                    <!-- YouTube-Style Bottom Controls Overlay -->
                    <Border x:Name="ControlsOverlay" VerticalAlignment="Bottom" Padding="14,28,14,10"
                            Panel.ZIndex="5" MouseEnter="ControlsOverlay_MouseEnter" MouseLeave="ControlsOverlay_MouseLeave">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#0005070C" Offset="0" />
                                <GradientStop Color="#8C05070C" Offset="0.42" />
                                <GradientStop Color="#EB05070C" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <!-- Hover Time Preview Tooltip above Seekbar -->
                            <Canvas x:Name="SeekHoverCanvas" Height="22" IsHitTestVisible="False" ClipToBounds="False">
                                <Border x:Name="SeekHoverBadge" Background="#E610131C" BorderBrush="#33FFFFFF" BorderThickness="1"
                                        CornerRadius="6" Padding="7,2" Visibility="Collapsed">
                                    <TextBlock x:Name="SeekHoverText" Foreground="#FFFFFF" FontSize="11.5" FontWeight="SemiBold" Text="0:00" />
                                </Border>
                            </Canvas>

                            <!-- Seek Slider -->
                            <Slider x:Name="SeekSlider" Style="{StaticResource YouTubeSlider}" Minimum="0" Maximum="1"
                                    Margin="2,0,2,4"
                                    ValueChanged="SeekSlider_ValueChanged"
                                    PreviewMouseLeftButtonDown="SeekSlider_PreviewMouseLeftButtonDown"
                                    PreviewMouseLeftButtonUp="SeekSlider_PreviewMouseLeftButtonUp"
                                    MouseMove="SeekSlider_MouseMove"
                                    MouseLeave="SeekSlider_MouseLeave" />

                            <!-- Controls Row -->
                            <DockPanel>
                                <!-- Left Playback & Volume & Time -->
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <!-- Play / Pause -->
                                    <Button x:Name="PlayPauseBtn" Style="{StaticResource PlayerIconButton}" Margin="0,0,2,0" Click="PlayPause_Click"
                                            ToolTip="{Binding [player.play], Source={x:Static loc:Loc.Instance}}">
                                        <Path x:Name="PlayPauseIcon" Data="M 4,2 L 15,9 L 4,16 Z" Fill="#FFFFFF" Width="15" Height="16" Stretch="Uniform" />
                                    </Button>

                                    <!-- Rewind 5s -->
                                    <Button Style="{StaticResource PlayerIconButton}" Margin="0,0,2,0" Click="Rewind_Click"
                                            ToolTip="{Binding [player.rewind5], Source={x:Static loc:Loc.Instance}}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M 8,3 L 3,7 L 8,11 M 4,7 L 12,7 A 4,4 0 1 1 8,11"
                                                  Stroke="#F0F3FA" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,3,0" />
                                            <TextBlock Text="5" FontSize="11.5" Foreground="#F0F3FA" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Forward 5s -->
                                    <Button Style="{StaticResource PlayerIconButton}" Margin="0,0,6,0" Click="Forward_Click"
                                            ToolTip="{Binding [player.forward5], Source={x:Static loc:Loc.Instance}}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="5" FontSize="11.5" Foreground="#F0F3FA" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,3,0" />
                                            <Path Data="M 8,3 L 13,7 L 8,11 M 12,7 L 4,7 A 4,4 0 1 0 8,11"
                                                  Stroke="#F0F3FA" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Width="14" Height="14" Stretch="Uniform" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Volume Mute + Slider -->
                                    <Button x:Name="MuteBtn" Style="{StaticResource PlayerIconButton}" Margin="0,0,2,0" Click="Mute_Click"
                                            ToolTip="{Binding [player.mute], Source={x:Static loc:Loc.Instance}}">
                                        <Path x:Name="VolumeIcon"
                                              Data="M 2,6 L 6,6 L 10,2.5 L 10,13.5 L 6,10 L 2,10 Z M 12.5,5.2 A 4,4 0 0 1 12.5,10.8 M 14.5,3.2 A 7,7 0 0 1 14.5,12.8"
                                              Stroke="#F0F3FA" Fill="#F0F3FA" StrokeThickness="1.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="17" Height="16" Stretch="Uniform" />
                                    </Button>
                                    <Slider x:Name="VolumeSlider" Style="{StaticResource YouTubeSlider}" Width="78" Minimum="0" Maximum="1" Value="1"
                                            VerticalAlignment="Center" Margin="2,0,14,0" ValueChanged="VolumeSlider_ValueChanged" />

                                    <!-- Time Display -->
                                    <TextBlock x:Name="CurrentTimeText" Foreground="#FFFFFF" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Text="0:00" />
                                    <TextBlock Text=" / " Foreground="#99FFFFFF" FontSize="12.5" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TotalTimeText" Foreground="#B8C0D4" FontSize="12.5" VerticalAlignment="Center" Text="0:00" />
                                </StackPanel>

                                <!-- Right Utility, CC, Speed, Theater, Fullscreen -->
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <!-- Screenshot -->
                                    <Button Style="{StaticResource PlayerIconButton}" Margin="0,0,2,0" Click="Snap_Click"
                                            ToolTip="{Binding [player.titlebar.snap], Source={x:Static loc:Loc.Instance}}">
                                        <Path Data="M 2,5 L 5,5 L 6.5,3 L 11.5,3 L 13,5 L 16,5 L 16,14 L 2,14 Z M 9,6.5 A 3,3 0 1 0 9,12.5 A 3,3 0 1 0 9,6.5"
                                              Stroke="#F0F3FA" StrokeThickness="1.5" StrokeLineJoin="Round"
                                              Width="17" Height="15" Stretch="Uniform" />
                                    </Button>

                                    <!-- Subtitles CC -->
                                    <Button x:Name="CcBtn" Style="{StaticResource PlayerIconButton}" Margin="0,0,2,0" Click="Cc_Click"
                                            ToolTip="{Binding [player.cc], Source={x:Static loc:Loc.Instance}}">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="CC" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                            <Border x:Name="CcActiveBar" Height="2.5" Width="18" CornerRadius="1" Background="{DynamicResource AccentBrush}" Margin="0,1,0,0" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Playback Speed Menu -->
                                    <Button x:Name="SpeedBtn" Style="{StaticResource PlayerIconButton}" Margin="0,0,2,0" Click="Speed_Click"
                                            ToolTip="{Binding [player.speed], Source={x:Static loc:Loc.Instance}}">
                                        <TextBlock x:Name="SpeedBtnText" Text="1×" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                    </Button>

                                    <!-- Theater / Expand View -->
                                    <Button x:Name="TheaterBtn" Style="{StaticResource PlayerIconButton}" Margin="0,0,2,0" Click="Theater_Click"
                                            ToolTip="{Binding [player.theater], Source={x:Static loc:Loc.Instance}}">
                                        <Path x:Name="TheaterIcon"
                                              Data="M 1.5,3.5 L 16.5,3.5 L 16.5,12.5 L 1.5,12.5 Z"
                                              Stroke="#F0F3FA" StrokeThickness="1.7" StrokeLineJoin="Round"
                                              Width="18" Height="13" Stretch="Uniform" />
                                    </Button>

                                    <!-- Fullscreen -->
                                    <Button x:Name="FullscreenBtn" Style="{StaticResource PlayerIconButton}" Click="Fullscreen_Click"
                                            ToolTip="{Binding [player.fullscreen], Source={x:Static loc:Loc.Instance}}">
                                        <Path x:Name="FullscreenIcon"
                                              Data="M 2,6 L 2,2 L 6,2 M 12,2 L 16,2 L 16,6 M 16,12 L 16,16 L 12,16 M 6,16 L 2,16 L 2,12"
                                              Stroke="#FFFFFF" StrokeThickness="1.8"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="16" Height="16" Stretch="Uniform" />
                                    </Button>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Preparing Proxy Overlay -->
                    <Border x:Name="PreparingOverlay" Background="#E6070A10" Visibility="Collapsed" Panel.ZIndex="6">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="320">
                            <TextBlock Text="{Binding [player.preparingPreview], Source={x:Static loc:Loc.Instance}}"
                                       FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <ProgressBar x:Name="PreparingBar" Height="6" Minimum="0" Maximum="1" Margin="0,12,0,6" />
                            <TextBlock x:Name="PreparingPct" Style="{StaticResource SubtleText}" HorizontalAlignment="Center" Text="0%" />
                            <TextBlock x:Name="PreparingDetail" Style="{StaticResource SubtleText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Below-Video Section (hidden in Theater & Fullscreen modes) -->
            <StackPanel x:Name="BelowVideoPanel" Grid.Row="2" Margin="0,10,0,0">
                <!-- Action Buttons Bar -->
                <WrapPanel Margin="0,0,0,8">
                    <Button x:Name="FavBtn" Style="{StaticResource DarkButton}" Padding="12,7" Margin="0,0,8,4" Click="Fav_Click" />
                    <Button Style="{StaticResource PrimaryButton}" Padding="14,7" Margin="0,0,8,4" Click="Cut_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✂ " Foreground="#FFFFFF" />
                            <TextBlock Text="{Binding [playerActions.cut], Source={x:Static loc:Loc.Instance}}" Foreground="#FFFFFF" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CloudBtn" Style="{StaticResource DarkButton}" Padding="12,7" Margin="0,0,8,4"
                            Content="{Binding [playerActions.cloud], Source={x:Static loc:Loc.Instance}}" Click="Cloud_Click" Visibility="Collapsed" />
                    <Button x:Name="FoldersBtn" Style="{StaticResource DarkButton}" Padding="12,7" Margin="0,0,8,4"
                            Content="{Binding [playerActions.folders], Source={x:Static loc:Loc.Instance}}" Click="Folders_Click" />
                    <Button x:Name="RetranscribeBtn" Style="{StaticResource DarkButton}" Padding="12,7" Margin="0,0,8,4"
                            Content="{Binding [playerActions.retranscribe], Source={x:Static loc:Loc.Instance}}" Click="Retranscribe_Click" />
                    <Button x:Name="TranscriptTxtBtn" Style="{StaticResource DarkButton}" Padding="12,7" Margin="0,0,8,4"
                            Content="{Binding [playerActions.transcriptTxt], Source={x:Static loc:Loc.Instance}}" Click="TranscriptTxt_Click" />
                    <Button x:Name="FixBtn" Style="{StaticResource DarkButton}" Padding="12,7" Margin="0,0,8,4"
                            Content="{Binding [playerActions.fix], Source={x:Static loc:Loc.Instance}}" Click="Fix_Click" />
                    <Button Style="{StaticResource DangerButton}" Padding="12,7" Margin="0,0,0,4"
                            Content="{Binding [playerActions.delete], Source={x:Static loc:Loc.Instance}}" Click="Delete_Click" />
                </WrapPanel>

                <!-- CS2 Demo Panel -->
                <Border Style="{StaticResource CardBorder}" Padding="12,8" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding [demo.title], Source={x:Static loc:Loc.Instance}}" FontWeight="SemiBold" FontSize="12.5" />
                            <TextBlock x:Name="DemoStatusText" Style="{StaticResource SubtleText}" FontSize="11" />
                        </StackPanel>
                        <TextBox x:Name="DemoPathBox" Grid.Column="1" Style="{StaticResource DarkTextBox}"
                                 Tag="{Binding [demo.placeholder], Source={x:Static loc:Loc.Instance}}"
                                 Margin="0,0,8,0" />
                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Padding="10,6" Content="{Binding [demo.browse], Source={x:Static loc:Loc.Instance}}" Margin="0,0,6,0" Click="DemoBrowse_Click" />
                        <Button Grid.Column="3" Style="{StaticResource PrimaryButton}" Padding="12,6" Content="{Binding [demo.assign], Source={x:Static loc:Loc.Instance}}" Margin="0,0,6,0" Click="DemoAssign_Click" />
                        <Button x:Name="DemoShowBtn" Grid.Column="4" Style="{StaticResource GhostButton}" Padding="10,6" Content="{Binding [demo.show], Source={x:Static loc:Loc.Instance}}" Margin="0,0,6,0" Visibility="Collapsed" Click="DemoShow_Click" />
                        <Button x:Name="DemoRemoveBtn" Grid.Column="5" Style="{StaticResource DangerButton}" Padding="10,6" Content="{Binding [demo.detach], Source={x:Static loc:Loc.Instance}}" Visibility="Collapsed" Click="DemoRemove_Click" />
                    </Grid>
                </Border>

                <!-- Transcript Segments -->
                <Border Style="{StaticResource CardBorder}" Padding="8" Height="124">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="SegmentsPanel" />
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
