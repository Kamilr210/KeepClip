<Window x:Class="KeepClip.UI.CutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:KeepClip.Localization"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        Width="760"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Border Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="22">
        <StackPanel>
            <DockPanel Margin="0,0,0,6">
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="✕" Padding="10,4" Click="Cancel_Click" />
                <TextBlock Text="{Binding [cutOverlay.title], Source={x:Static loc:Loc.Instance}}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock x:Name="SourceNameText" Style="{StaticResource SubtleText}" Margin="0,0,0,12" />

            <Border Background="#000000" CornerRadius="10" Height="280" ClipToBounds="True">
                <MediaElement x:Name="PreviewMedia" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform"
                              MediaOpened="PreviewMedia_MediaOpened" />
            </Border>

            <DockPanel Margin="0,10,0,6">
                <Button x:Name="PlayPauseBtn" DockPanel.Dock="Left" Style="{StaticResource DarkButton}" Content="▶" Padding="14,6" Click="PlayPause_Click" />
                <TextBlock x:Name="TimeText" DockPanel.Dock="Right" Style="{StaticResource SubtleText}" VerticalAlignment="Center" Margin="10,0,0,0" Text="0:00 / 0:00" />
                <Slider x:Name="SeekSlider" Minimum="0" Maximum="1" VerticalAlignment="Center" Margin="10,0"
                        ValueChanged="SeekSlider_ValueChanged" />
            </DockPanel>

            <Grid Margin="0,8,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <DockPanel>
                        <TextBlock Text="{Binding [cutOverlay.startLabel], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SubtleText}" />
                        <TextBlock x:Name="StartLabel" DockPanel.Dock="Right" FontWeight="SemiBold" Text="0:00" />
                    </DockPanel>
                    <Slider x:Name="StartSlider" Minimum="0" Maximum="1" ValueChanged="RangeSlider_ValueChanged" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <DockPanel>
                        <TextBlock Text="{Binding [cutOverlay.endLabel], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SubtleText}" />
                        <TextBlock x:Name="EndLabel" DockPanel.Dock="Right" FontWeight="SemiBold" Text="0:00" />
                    </DockPanel>
                    <Slider x:Name="EndSlider" Minimum="0" Maximum="1" ValueChanged="RangeSlider_ValueChanged" />
                </StackPanel>
            </Grid>
            <TextBlock x:Name="DurationLabel" Style="{StaticResource SubtleText}" HorizontalAlignment="Center" Margin="0,2,0,12" />

            <TextBlock Text="{Binding [cutOverlay.targetLabel], Source={x:Static loc:Loc.Instance}}" FontWeight="SemiBold" Margin="0,0,0,8" />
            <WrapPanel x:Name="PresetsPanel" Margin="0,0,0,8">
                <Button Style="{StaticResource PrimaryButton}" Tag="" Content="{Binding [cutOverlay.noComprBtn], Source={x:Static loc:Loc.Instance}}" Margin="0,0,8,8" Click="Preset_Click" />
                <Button Style="{StaticResource DarkButton}" Tag="20" Content="20 MB (Discord)" Margin="0,0,8,8" Click="Preset_Click" />
                <Button Style="{StaticResource DarkButton}" Tag="25" Content="25 MB" Margin="0,0,8,8" Click="Preset_Click" />
                <Button Style="{StaticResource DarkButton}" Tag="50" Content="50 MB (Nitro Basic)" Margin="0,0,8,8" Click="Preset_Click" />
                <Button Style="{StaticResource DarkButton}" Tag="100" Content="100 MB" Margin="0,0,8,8" Click="Preset_Click" />
                <Button Style="{StaticResource DarkButton}" Tag="500" Content="500 MB (Nitro)" Margin="0,0,8,8" Click="Preset_Click" />
            </WrapPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="{Binding [cutOverlay.customLabel], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SubtleText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="CustomMbBox" Style="{StaticResource DarkTextBox}" Width="90" TextChanged="CustomMbBox_TextChanged" />
                <TextBlock Text="MB" Style="{StaticResource SubtleText}" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>

            <TextBlock x:Name="EstimateText" Style="{StaticResource SubtleText}" Margin="0,2,0,6" />
            <ProgressBar x:Name="CutProgress" Height="6" Minimum="0" Maximum="1" Visibility="Collapsed" Margin="0,4,0,6" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource Card2Brush}" BorderThickness="0" />
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="0,4,0,0" Visibility="Collapsed" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Style="{StaticResource GhostButton}" Content="{Binding [cutOverlay.cancelBtn], Source={x:Static loc:Loc.Instance}}" Margin="0,0,10,0" Click="Cancel_Click" />
                <Button x:Name="GoBtn" Style="{StaticResource PrimaryButton}" Content="{Binding [cutOverlay.goBtn], Source={x:Static loc:Loc.Instance}}" Click="Go_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

