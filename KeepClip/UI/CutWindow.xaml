<Window x:Class="KeepClip.UI.CutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:KeepClip.Localization"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        Width="880"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Margin="14"
            Background="{DynamicResource CardBrush}"
            BorderBrush="#2D3344"
            BorderThickness="1"
            CornerRadius="16"
            Padding="22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.6" Color="#000000" />
        </Border.Effect>
        <StackPanel>
            <!-- Draggable Header -->
            <DockPanel Margin="0,0,0,10" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="✕" Padding="10,4" Click="Cancel_Click" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding [cutOverlay.title], Source={x:Static loc:Loc.Instance}}" FontSize="18" FontWeight="Bold" />
                    <TextBlock x:Name="SourceNameText" Style="{StaticResource SubtleText}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>

            <!-- Preview Monitor -->
            <Border Background="#000000" CornerRadius="12" Height="260" ClipToBounds="True">
                <Grid>
                    <MediaElement x:Name="PreviewMedia" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform"
                                  MediaOpened="PreviewMedia_MediaOpened" />
                    <Border Background="Transparent" MouseLeftButtonDown="PreviewSurface_Click" />

                    <!-- Overlaid Bottom Controls -->
                    <Border VerticalAlignment="Bottom" Padding="12,18,12,8">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#0005070C" Offset="0" />
                                <GradientStop Color="#E605070C" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                <Button x:Name="PlayPauseBtn" Style="{StaticResource PlayerIconButton}" Margin="0,0,2,0" Click="PlayPause_Click">
                                    <Path x:Name="PlayPauseIcon" Data="M 4,2 L 15,9 L 4,16 Z" Fill="#FFFFFF" Width="14" Height="15" Stretch="Uniform" />
                                </Button>
                                <Button Style="{StaticResource PlayerIconButton}" Margin="0,0,2,0" Click="StepBack_Click" ToolTip="-2s (←)">
                                    <TextBlock Text="-2s" FontSize="11.5" Foreground="#F0F3FA" FontWeight="SemiBold" />
                                </Button>
                                <Button Style="{StaticResource PlayerIconButton}" Margin="0,0,8,0" Click="StepFwd_Click" ToolTip="+2s (→)">
                                    <TextBlock Text="+2s" FontSize="11.5" Foreground="#F0F3FA" FontWeight="SemiBold" />
                                </Button>
                                <TextBlock x:Name="TimeText" Foreground="#E6ECFA" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Text="0:00 / 0:00" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Style="{StaticResource PlayerIconButton}" Height="28" Padding="8,2" Margin="0,0,4,0" Click="SetStartHere_Click"
                                        ToolTip="{Binding [cutOverlay.startLabel], Source={x:Static loc:Loc.Instance}}">
                                    <TextBlock Text="{Binding [cutOverlay.setStartHere], Source={x:Static loc:Loc.Instance}}" FontSize="11.5" Foreground="#E6ECFA" />
                                </Button>
                                <Button Style="{StaticResource PlayerIconButton}" Height="28" Padding="8,2" Margin="0,0,8,0" Click="SetEndHere_Click"
                                        ToolTip="{Binding [cutOverlay.endLabel], Source={x:Static loc:Loc.Instance}}">
                                    <TextBlock Text="{Binding [cutOverlay.setEndHere], Source={x:Static loc:Loc.Instance}}" FontSize="11.5" Foreground="#E6ECFA" />
                                </Button>
                                <Border Background="{DynamicResource AccentPanelBrush}" CornerRadius="7" Padding="10,4" VerticalAlignment="Center">
                                    <TextBlock x:Name="DurationLabel" Foreground="{DynamicResource AccentPaleBrush}" FontSize="12" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Multi-Track NLE Timeline (Video V1 + Audio A1) -->
            <Border Background="#0E1118" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,12,0,10">
                <StackPanel>
                    <!-- Time Ruler Row -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="134" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="TIMELINE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="4,0,0,0" />
                        <Grid x:Name="RulerGrid" Grid.Column="1" Height="18" Background="Transparent" Cursor="Hand"
                              MouseLeftButtonDown="Timeline_MouseDown" MouseMove="Timeline_MouseMove" MouseLeftButtonUp="Timeline_MouseUp">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="RulerT0" Grid.Column="0" Text="0:00" FontSize="10" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Left" />
                            <TextBlock x:Name="RulerT1" Grid.Column="1" Text="" FontSize="10" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Left" />
                            <TextBlock x:Name="RulerT2" Grid.Column="2" Text="" FontSize="10" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Left" />
                            <TextBlock x:Name="RulerT3" Grid.Column="3" Text="" FontSize="10" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" />
                        </Grid>
                    </Grid>

                    <!-- Tracks Area + Shared Playhead Overlay -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="134" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="44" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="48" />
                        </Grid.RowDefinitions>

                        <!-- Track V1 Header -->
                        <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource Card2Brush}" CornerRadius="8" Padding="8,5" Margin="0,0,8,0">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Background="{DynamicResource AccentBrush}" CornerRadius="5" Width="26" Height="24" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="V1" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding [cutOverlay.videoTrack], Source={x:Static loc:Loc.Instance}}" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock x:Name="VideoRangeBadge" Style="{StaticResource SubtleText}" FontSize="10" Text="0:00 – 0:00" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Track V1 Timeline Bar -->
                        <Border x:Name="VideoTrackHost" Grid.Row="0" Grid.Column="1" Background="#171B26" CornerRadius="8" ClipToBounds="True"
                                SizeChanged="TimelineTrack_SizeChanged"
                                MouseLeftButtonDown="Timeline_MouseDown" MouseMove="Timeline_MouseMove" MouseLeftButtonUp="Timeline_MouseUp">
                            <Canvas x:Name="VideoTrackCanvas" ClipToBounds="True">
                                <Border x:Name="VideoActiveClip" Height="36" Canvas.Top="4" CornerRadius="6"
                                        Background="{DynamicResource AccentPanelBrush}"
                                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5">
                                    <TextBlock x:Name="VideoClipCaption" Foreground="{DynamicResource AccentPaleBrush}" FontSize="11" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Margin="14,0,14,0" TextTrimming="CharacterEllipsis" />
                                </Border>
                                <Border x:Name="LeftTrimHandle" Width="10" Height="40" Canvas.Top="2" CornerRadius="4,0,0,4"
                                        Background="{DynamicResource AccentBrush}" Cursor="SizeWE"
                                        MouseLeftButtonDown="LeftHandle_MouseDown" MouseMove="TrimHandle_MouseMove" MouseLeftButtonUp="TrimHandle_MouseUp">
                                    <Border Width="2" Height="16" Background="#FFFFFF" CornerRadius="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border x:Name="RightTrimHandle" Width="10" Height="40" Canvas.Top="2" CornerRadius="0,4,4,0"
                                        Background="{DynamicResource AccentBrush}" Cursor="SizeWE"
                                        MouseLeftButtonDown="RightHandle_MouseDown" MouseMove="TrimHandle_MouseMove" MouseLeftButtonUp="TrimHandle_MouseUp">
                                    <Border Width="2" Height="16" Background="#FFFFFF" CornerRadius="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Canvas>
                        </Border>

                        <!-- Track A1 Header (Click to slide out Volume Mixer Popup) -->
                        <Border x:Name="AudioHeaderBorder" Grid.Row="2" Grid.Column="0" Background="{DynamicResource Card2Brush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="8,5" Margin="0,0,8,0" Cursor="Hand"
                                ToolTip="{Binding [cutOverlay.audioVolume], Source={x:Static loc:Loc.Instance}}"
                                MouseLeftButtonUp="AudioHeader_Click">
                            <Grid>
                                <DockPanel>
                                    <Border x:Name="AudioTrackBadge" DockPanel.Dock="Left" Background="#1F6E43" CornerRadius="5" Width="26" Height="24" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <TextBlock Text="A1" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Button x:Name="AudioMixerToggleBtn" DockPanel.Dock="Right" Style="{StaticResource CardOverlayButton}"
                                            Background="Transparent" Padding="4,2" Click="AudioMixerToggle_Click" VerticalAlignment="Center">
                                        <Path x:Name="MuteIcon"
                                              Data="M 2,6 L 6,6 L 10,2.5 L 10,13.5 L 6,10 L 2,10 Z M 12.5,5.2 A 4,4 0 0 1 12.5,10.8"
                                              Stroke="#43D17A" Fill="#43D17A" StrokeThickness="1.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="14" Height="14" Stretch="Uniform" />
                                    </Button>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding [cutOverlay.audioTrack], Source={x:Static loc:Loc.Instance}}" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock x:Name="AudioPctBadge" Foreground="#43D17A" FontSize="10.5" FontWeight="SemiBold" Text="100% ▾" />
                                    </StackPanel>
                                </DockPanel>

                                <!-- Slide-Out Volume Mixer Popup attached to Left A1 Track Header -->
                                <Popup x:Name="AudioMixerPopup"
                                       PlacementTarget="{Binding ElementName=AudioHeaderBorder}"
                                       Placement="Right"
                                       HorizontalOffset="6"
                                       VerticalOffset="-12"
                                       StaysOpen="False"
                                       AllowsTransparency="True"
                                       PopupAnimation="Slide">
                                    <Border Margin="8"
                                            Background="{DynamicResource CardBrush}"
                                            BorderBrush="#363D52"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="14,12"
                                            Width="320">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="22" ShadowDepth="6" Opacity="0.65" Color="#000000" />
                                        </Border.Effect>
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,8">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="7,3" Click="Mute_Click" ToolTip="{Binding [player.mute], Source={x:Static loc:Loc.Instance}}">
                                                    <Path x:Name="PopupMuteIcon"
                                                          Data="M 2,6 L 6,6 L 10,2.5 L 10,13.5 L 6,10 L 2,10 Z M 12.5,5.2 A 4,4 0 0 1 12.5,10.8"
                                                          Stroke="#43D17A" Fill="#43D17A" StrokeThickness="1.5"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          Width="14" Height="14" Stretch="Uniform" />
                                                </Button>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding [cutOverlay.audioVolume], Source={x:Static loc:Loc.Instance}}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="AudioGainLabel" Foreground="#43D17A" FontSize="12.5" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center" Text="100%" />
                                                </StackPanel>
                                            </DockPanel>

                                            <Slider x:Name="AudioVolumeSlider" Style="{StaticResource YouTubeSlider}" Minimum="0" Maximum="300" Value="100"
                                                    Margin="0,0,0,10" ValueChanged="AudioVolumeSlider_ValueChanged" />

                                            <UniformGrid Columns="6">
                                                <Button Style="{StaticResource GhostButton}" Padding="4,4" FontSize="11" Content="0%" Tag="0" Margin="0,0,3,0" Click="AudioPreset_Click" />
                                                <Button Style="{StaticResource GhostButton}" Padding="4,4" FontSize="11" Content="50%" Tag="50" Margin="1.5,0" Click="AudioPreset_Click" />
                                                <Button Style="{StaticResource DarkButton}" Padding="4,4" FontSize="11" Content="100%" Tag="100" Margin="1.5,0" Click="AudioPreset_Click" />
                                                <Button Style="{StaticResource GhostButton}" Padding="4,4" FontSize="11" Content="150%" Tag="150" Margin="1.5,0" Click="AudioPreset_Click" />
                                                <Button Style="{StaticResource GhostButton}" Padding="4,4" FontSize="11" Content="200%" Tag="200" Margin="1.5,0" Click="AudioPreset_Click" />
                                                <Button Style="{StaticResource GhostButton}" Padding="4,4" FontSize="11" Content="300%" Tag="300" Margin="3,0,0,0" Click="AudioPreset_Click" />
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>

                        <!-- Track A1 Real Audio Waveform Bar -->
                        <Border x:Name="AudioTrackHost" Grid.Row="2" Grid.Column="1" Background="#13191F" CornerRadius="8" ClipToBounds="True"
                                MouseLeftButtonDown="Timeline_MouseDown" MouseMove="Timeline_MouseMove" MouseLeftButtonUp="Timeline_MouseUp">
                            <Canvas x:Name="AudioTrackCanvas" ClipToBounds="True">
                                <Border x:Name="AudioActiveClip" Height="40" Canvas.Top="4" CornerRadius="6"
                                        Background="#143325" BorderBrush="#2D8C56" BorderThickness="1.2" ClipToBounds="True">
                                    <Canvas x:Name="WaveformCanvas" />
                                </Border>
                            </Canvas>
                        </Border>

                        <!-- Shared Playhead Line across V1 & A1 -->
                        <Canvas x:Name="PlayheadOverlayCanvas" Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" IsHitTestVisible="False" ClipToBounds="False">
                            <Border x:Name="PlayheadHead" Width="10" Height="8" Canvas.Top="-4" CornerRadius="2" Background="#FFFFFF" />
                            <Border x:Name="PlayheadLine" Width="2" Height="98" Canvas.Top="0" Background="#FFFFFF" />
                        </Canvas>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Target Size Presets -->
            <DockPanel Margin="0,2,0,6">
                <TextBlock x:Name="EstimateText" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SubtleText}" />
                <TextBlock Text="{Binding [cutOverlay.targetLabel], Source={x:Static loc:Loc.Instance}}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <WrapPanel x:Name="PresetsPanel" Margin="0,0,0,6">
                <Button Style="{StaticResource PrimaryButton}" Tag="" Padding="11,6" Content="{Binding [cutOverlay.noComprBtn], Source={x:Static loc:Loc.Instance}}" Margin="0,0,6,6" Click="Preset_Click" />
                <Button Style="{StaticResource DarkButton}" Tag="20" Padding="11,6" Content="20 MB (Discord)" Margin="0,0,6,6" Click="Preset_Click" />
                <Button Style="{StaticResource DarkButton}" Tag="25" Padding="11,6" Content="25 MB" Margin="0,0,6,6" Click="Preset_Click" />
                <Button Style="{StaticResource DarkButton}" Tag="50" Padding="11,6" Content="50 MB (Nitro Basic)" Margin="0,0,6,6" Click="Preset_Click" />
                <Button Style="{StaticResource DarkButton}" Tag="100" Padding="11,6" Content="100 MB" Margin="0,0,6,6" Click="Preset_Click" />
                <Button Style="{StaticResource DarkButton}" Tag="500" Padding="11,6" Content="500 MB (Nitro)" Margin="0,0,6,6" Click="Preset_Click" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,6">
                    <TextBlock Text="{Binding [cutOverlay.customLabel], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SubtleText}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox x:Name="CustomMbBox" Style="{StaticResource DarkTextBox}" Width="74" Padding="8,5" TextChanged="CustomMbBox_TextChanged" />
                    <TextBlock Text="MB" Style="{StaticResource SubtleText}" VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>
            </WrapPanel>

            <ProgressBar x:Name="CutProgress" Height="6" Minimum="0" Maximum="1" Visibility="Collapsed" Margin="0,4,0,6" />
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="0,4,0,0" Visibility="Collapsed" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Style="{StaticResource GhostButton}" Content="{Binding [cutOverlay.cancelBtn], Source={x:Static loc:Loc.Instance}}" Margin="0,0,10,0" Click="Cancel_Click" />
                <Button x:Name="GoBtn" Style="{StaticResource PrimaryButton}" Padding="18,8" Content="{Binding [cutOverlay.goBtn], Source={x:Static loc:Loc.Instance}}" Click="Go_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
