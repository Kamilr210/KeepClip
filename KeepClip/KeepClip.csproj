<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>

    <ApplicationIcon>Assets\icons\icon.ico</ApplicationIcon>
    <AssemblyName>KeepClip</AssemblyName>
    <Product>KeepClip</Product>
    <Company>Kamil</Company>
    <Authors>Kamil</Authors>
    <Description>KeepClip — przeglądarka i wyszukiwarka klipów z transkrypcją (Whisper) i offloadem na Google Drive.</Description>
    <Version>2.5.0</Version>
    <FileVersion>2.5.0.0</FileVersion>
    <AssemblyVersion>2.5.0.0</AssemblyVersion>
    <Copyright>© Kamil</Copyright>

    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <RuntimeFrameworkVersion>10.0.14</RuntimeFrameworkVersion>

    <PublicRelease Condition="'$(PublicRelease)' == ''">false</PublicRelease>
    <DefineConstants Condition="'$(PublicRelease)' != 'true'">$(DefineConstants);KEEPCLIP_DEV</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KeepClip.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <!-- Whisper.net wybiera Vulkan, gdy GPU jest dostępny, a w przeciwnym razie używa CPU. -->
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <!-- NAudio dostarcza dźwięk WASAPI do wejścia FFmpeg, który sam nie obsługuje przechwytywania zwrotnego. -->
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\icons\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\sounds\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="StageRuntimeAssets" AfterTargets="Publish">
    <PropertyGroup>
      <_Pub>$([MSBuild]::EnsureTrailingSlash('$(PublishDir)'))</_Pub>
    </PropertyGroup>
    <ItemGroup>
      <_AssetsFiles Include="Assets\**\*" />
      <_ToolsFiles Include="..\tools\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_AssetsFiles)"
          DestinationFiles="@(_AssetsFiles->'$(_Pub)Assets\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_ToolsFiles)"
          DestinationFiles="@(_ToolsFiles->'$(_Pub)tools\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\installer\stage-licenses.ps1&quot; -PublishDir &quot;$(_Pub).&quot; -AssetsFile &quot;$(ProjectAssetsFile)&quot;" />
    <Message Importance="high" Text="KeepClip: staged Assets/ + tools/ into $(_Pub)" />
  </Target>

</Project>
