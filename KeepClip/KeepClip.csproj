<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Typ aplikacji ukrywa konsolę, a osobny tryb pozwala uruchomić sam serwer. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>

    <ApplicationIcon>..\frontend\icons\icon.ico</ApplicationIcon>
    <AssemblyName>KeepClip</AssemblyName>
    <Product>KeepClip</Product>
    <Company>Kamil</Company>
    <Authors>Kamil</Authors>
    <Description>KeepClip — przeglądarka i wyszukiwarka klipów z transkrypcją (Whisper) i offloadem na Google Drive.</Description>
    <Version>2.2.3</Version>
    <FileVersion>2.2.3.0</FileVersion>
    <AssemblyVersion>2.2.3.0</AssemblyVersion>
    <Copyright>© Kamil</Copyright>

    <!-- Publikacja samowystarczalna pozostaje katalogiem bez przycinania, ponieważ WebView2
         i natywne biblioteki Whispera muszą istnieć jako osobne pliki. -->
    <!-- Interfejs ma własne tłumaczenia HTML, więc wystarczą angielskie zasoby platformy. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- Właściwość PublicRelease usuwa panel logów z instalatora publikowanego przez CI. -->
    <PublicRelease Condition="'$(PublicRelease)' == ''">false</PublicRelease>
    <DefineConstants Condition="'$(PublicRelease)' != 'true'">$(DefineConstants);KEEPCLIP_DEV</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <!-- Microsoft.Data.Sqlite (także 10.0.10) ciągnie przechodnio podatną SQLitePCLRaw 2.1.11
         (NU1903, GHSA-2m69-gcr7-jv3q); bezpośrednia referencja wymusza załataną wersję.
         Do usunięcia, gdy Microsoft.Data.Sqlite zacznie zależeć od >= 2.1.12. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" />
    <!-- Whisper.net wybiera Vulkan, gdy GPU jest dostępny, a w przeciwnym razie używa CPU. -->
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <!-- NAudio dostarcza dźwięk WASAPI do wejścia FFmpeg, który sam nie obsługuje przechwytywania zwrotnego. -->
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <!-- Usuwa nieużywaną bibliotekę WPF przed etapem RAR, aby uniknąć konfliktu WindowsBase. -->
  <Target Name="DropWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)"
                 Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

  <!-- Dołącza interfejs i narzędzia do publikacji; model Whispera oraz dane użytkownika
       nie mogą trafić do instalatora. -->
  <Target Name="StageRuntimeAssets" AfterTargets="Publish">
    <PropertyGroup>
      <_Pub>$([MSBuild]::EnsureTrailingSlash('$(PublishDir)'))</_Pub>
    </PropertyGroup>
    <ItemGroup>
      <_FrontendFiles Include="..\frontend\**\*" />
      <_ToolsFiles Include="..\tools\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_FrontendFiles)"
          DestinationFiles="@(_FrontendFiles->'$(_Pub)frontend\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_ToolsFiles)"
          DestinationFiles="@(_ToolsFiles->'$(_Pub)tools\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Message Importance="high" Text="KeepClip: staged frontend/ + tools/ into $(_Pub)" />
  </Target>

</Project>
